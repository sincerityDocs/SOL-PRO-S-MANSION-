{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sinceritydocs.github.io/sol-pro-mansion/artifact-reference.schema.json",
  "title": "Mansion Artifact Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "uri", "authority"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["git", "drive", "local", "url", "artifact", "runtime"]
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "authority": {
      "type": "string",
      "enum": ["authoritative", "current", "proposed", "historical", "experimental", "external"]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "checksum": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:+._-]{8,200}$"
    }
  }
}
